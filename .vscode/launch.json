{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current file (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "On fork: keep debugging the parent process",
          "text": "-gdb-set follow-fork-mode parent",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build current file"
    }
  ]
}
